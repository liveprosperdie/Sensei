# ==============================================================================
# Akira Configuration (.env)
# Copy this file to .env and fill in your own API keys.
# DO NOT COMMIT YOUR REAL .env FILE TO VERSION CONTROL!
# ==============================================================================

# ── Primary LLM Brains ────────────────────────────────────────────────────────
# Anthropic API Key (required for Claude Sonnet 5 / Opus router & reasoning head)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq API Key (required for free-tier fast router & speech head)
GROQ_API_KEY=your_groq_api_key_here
SPEECH_API_KEY=your_groq_speech_api_key_here

# Groq model configurations (defaults to openai/gpt-oss-120b and qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_FALLBACK_MODEL=qwen/qwen3.8-27b

# Optional: Disable Claude to test pure Free-Brain (Groq) execution (true/false)
AKIRA_DISABLE_CLAUDE=false

# ── Voice & Audio Configuration ───────────────────────────────────────────────
# Optional ElevenLabs TTS (if using ElevenLabs instead of edge-tts / pyttsx3)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Wake word threshold (default 0.08)
AKIRA_WAKE_THRESHOLD=0.08
AKIRA_DISABLE_VAD_INTERRUPT=false

# ── Procedural Memory ─────────────────────────────────────────────────────────
# Procedural memory mode: "shadow" (default, logs hits without replay) or "replay" or "off"
AKIRA_PROCEDURAL_MEMORY_MODE=shadow

# ── Integrations & Tool APIs (Optional) ───────────────────────────────────────
# Spotify Control (from Spotify Developer Dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Google Workspace / OAuth (Calendar, Docs, Drive, Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub Personal Access Token (for repo/issue actions)
GITHUB_TOKEN=

# Search APIs
SERPAPI_KEY=

# Discord Bot Token (if using Discord integration)
DISCORD_BOT_TOKEN=

# Obsidian REST API Key (from Obsidian Local REST API plugin)
OBSIDIAN_API_KEY=

# Gemini API Key (if testing Gemini speech/router head)
GEMINI_API_KEY=

# Cerebras API Key (optional ultra-fast inference)
CEREBRAS_API_KEY=

# Akira Operational Tier (default "pro")
AKIRA_TIER=pro
