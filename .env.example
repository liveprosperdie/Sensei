# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Speech / LLM ---
GROQ_API_KEY=

# --- Obsidian Focus Mode (see SETUP_OBSIDIAN_FOCUS_MODE.md) ---
# From Obsidian: Settings -> Local REST API -> API Key.
# Required for every note action; without it Obsidian features stay off.
OBSIDIAN_API_KEY=

# Optional. Defaults to https://127.0.0.1:27124 (the plugin's HTTPS default).
# Only set this if you changed the port or deliberately enabled the plain-HTTP
# server on 27123.
# OBSIDIAN_API_URL=http://127.0.0.1:27123

# --- Wake word tuning (optional) ---
# SENSEI_WAKE_THRESHOLD=
# SENSEI_WAKE_DEBUG=
